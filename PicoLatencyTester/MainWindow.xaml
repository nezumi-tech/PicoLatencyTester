<Window x:Class="PicoLatencyTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pico Latency Tester" Height="250" Width="550">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <!-- デバイス選択 (左) -->
            <ColumnDefinition Width="100"/>
            <!-- モノラル/L/R選択 (右) -->
        </Grid.ColumnDefinitions>

        <!-- L Channel (Top Row) -->
        <TextBlock Text="L Channel (Top):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="CmbDeviceL" Grid.Row="0" Grid.Column="1" Margin="0,0,10,10"/>
        <ComboBox x:Name="CmbModeL" Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
            <ComboBoxItem Content="Mono" IsSelected="True"/>
            <ComboBoxItem Content="Left"/>
            <ComboBoxItem Content="Right"/>
        </ComboBox>

        <!-- R Channel (Bottom Row) -->
        <TextBlock Text="R Channel (Btm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="CmbDeviceR" Grid.Row="1" Grid.Column="1" Margin="0,0,10,10"/>
        <ComboBox x:Name="CmbModeR" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
            <ComboBoxItem Content="Mono" IsSelected="True"/>
            <ComboBoxItem Content="Left"/>
            <ComboBoxItem Content="Right"/>
        </ComboBox>

        <!-- Controls -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="BtnRefresh" Content="デバイス再検出" Width="100" Margin="5" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnRecord" Content="録音開始" Width="100" Margin="5" Click="BtnRecord_Click"/>
            <Button x:Name="BtnPreview" Content="プレビュー" Width="100" Margin="5" Click="BtnPreview_Click" IsEnabled="False"/>
            <Button x:Name="BtnSave" Content="保存" Width="100" Margin="5" Click="BtnSave_Click" IsEnabled="False"/>
        </StackPanel>

        <TextBlock x:Name="TxtStatus" Grid.Row="3" Grid.ColumnSpan="3" Margin="5" Text="待機中 (デバイス未接続)" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
</Window>